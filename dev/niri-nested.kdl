// Throwaway niri that runs inside a window of your real session, so the shell can be
// developed without touching Noctalia. Started by dev/nested.sh.
input {
    keyboard {
        xkb {
        }
    }
}

layout {
    gaps 10
    focus-ring {
        off
    }
    border {
        off
    }
}

prefer-no-csd

// frosted glass for the amane windows. namespaces come from `niri msg layers`.
layer-rule {
    match namespace="^amane-bar$"
    background-effect {
        blur true
        xray true
        noise 0.02
        saturation 1.4
    }
}

layer-rule {
    match namespace="^amane-panel$"
    background-effect {
        blur true
        xray true
        noise 0.02
        saturation 1.4
    }
}

// publish this session's environment so dev/ctl.sh can talk to it
spawn-at-startup "sh" "-c" "export XDG_RUNTIME_DIR=/tmp/amane-nested-runtime WAYLAND_DISPLAY=/run/user/$(id -u)/$WAYLAND_DISPLAY; env > $HOME/Projects/amane/shell/dev/.env; exec $HOME/Projects/amane/shell/dev/.amane-shell-nested"

binds {
    Alt+Return { spawn "ghostty"; }
    Alt+Shift+E { quit skip-confirmation=true; }
    Alt+Q { close-window; }
}

hotkey-overlay {
    skip-at-startup
}
