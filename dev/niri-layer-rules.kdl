// paste into ~/.config/niri/config.kdl for the real session (frosted glass behind the shell)
layer-rule {
    match namespace="^amane-bar$"
    background-effect {
        blur true
        xray true
        noise 0.02
        saturation 1.4
    }
}

layer-rule {
    match namespace="^amane-panel$"
    background-effect {
        blur true
        xray true
        noise 0.02
        saturation 1.4
    }
}

// the wallpaper picker strip (full width, so no corner radius)
layer-rule {
    match namespace="^amane-dock$"
    background-effect {
        blur true
        xray true
        noise 0.02
        saturation 1.5
    }
}
